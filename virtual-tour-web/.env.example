# Public client-side values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here
VITE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Server-side only values for Supabase Edge Functions and the R2 uploader
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name

# Database URL for migrations (optional, only needed for setup_supabase.py migration step)
DB_DIRECT_URL=postgresql://user:password@host:5432/database
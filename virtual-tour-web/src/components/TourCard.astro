---
interface Props {
  name: string;
  description: string;
  coverImage: string;
  slug: string;
  nodeCount: number;
  coverageKm2: number;
  cameraModel: string;
}

const {
  name,
  description,
  coverImage,
  slug,
  nodeCount,
  coverageKm2,
  cameraModel,
} = Astro.props;
---

<a
  href={`/tour/${slug}`}
  class="group block h-full overflow-hidden rounded-3xl border border-white/10 bg-black/35 shadow-xl shadow-black/30 transition duration-200 hover:-translate-y-1 hover:border-emerald-300/40 hover:shadow-2xl"
  aria-label={`Start tour ${name}`}
>
  <div class="relative aspect-[2/1] overflow-hidden">
    <img
      src={coverImage}
      alt={name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
    />
  </div>

  <div class="p-5">
    <h3 class="text-xl font-bold text-white">{name}</h3>
    <p class="mt-2 line-clamp-2 text-sm text-slate-300">{description}</p>

    <div class="mt-3 text-sm text-slate-200">
      {nodeCount} locations · {coverageKm2.toFixed(2)} km²
    </div>

    <div class="mt-3 inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.15em] text-emerald-200">
      {cameraModel}
    </div>

    <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-sky-300">
      Start Tour <span aria-hidden="true">→</span>
    </div>
  </div>
</a>

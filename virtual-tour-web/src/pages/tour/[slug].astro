---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import { getTourBySlug } from '@services/supabase';
import { TourChrome } from '@components/islands/TourChrome';
import { VirtualTourViewer } from '@components/islands/VirtualTourViewer';
import { MapboxMiniMap } from '@components/islands/MapboxMiniMap';
import { NodeInfoPanel } from '@components/islands/NodeInfoPanel';
import { HotspotCompass } from '@components/islands/HotspotCompass';
import { TourNodeList } from '@components/islands/TourNodeList';
import type { TourRow } from '../../types/tour';

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug[0] : rawSlug;

if (!slug) return Astro.redirect('/404');

// ✅ Không redirect 404 im lặng — hiển thị lỗi rõ ràng
let tour: TourRow | null = null;
let loadError: string | null = null;

// ✅ Read env from Cloudflare runtime (works in SSR edge functions)
const runtimeEnv = (Astro.locals as any).runtime?.env ?? {};
const supabaseEnv = {
  VITE_SUPABASE_URL: runtimeEnv.VITE_SUPABASE_URL ?? import.meta.env.VITE_SUPABASE_URL ?? '',
  VITE_SUPABASE_ANON_KEY: runtimeEnv.VITE_SUPABASE_ANON_KEY ?? import.meta.env.VITE_SUPABASE_ANON_KEY ?? '',
};

try {
  tour = await getTourBySlug(slug, supabaseEnv);
} catch (err) {
  loadError = err instanceof Error ? err.message : String(err);
  console.error('[tour/slug] SSR error:', loadError);
}
---

{loadError || !tour ? (
  <BaseLayout title="Tour unavailable">
    <main class="flex min-h-screen items-center justify-center bg-black px-6 text-center">
      <div class="max-w-lg rounded-3xl border border-red-500/20 bg-red-950/30 p-8 text-white backdrop-blur-xl">
        <p class="text-xs uppercase tracking-widest text-red-400">Tour error</p>
        <h1 class="mt-3 text-2xl font-bold">Cannot load "{slug}"</h1>
        <p class="mt-3 text-sm text-slate-300 font-mono">{loadError}</p>
        <p class="mt-4 text-xs text-slate-500">Make sure VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are set in Cloudflare Pages → Settings → Environment Variables.</p>
        <a href="/" class="mt-6 inline-block rounded-full border border-white/10 bg-white/10 px-5 py-2 text-sm font-semibold hover:bg-white/20">← Back</a>
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout
    title={tour.name}
    description={tour.description ?? tour.name}
    image={tour.cover_image ?? '/hero-forest.svg'}
    canonical={Astro.url.href}
    viewport="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no"
  >
    <main class="relative min-h-screen overflow-hidden bg-black">
      <div class="absolute inset-0">
        <VirtualTourViewer client:only="react" tourSlug={slug} />
      </div>
      <div class="fixed left-0 top-0 z-30 h-full">
        <TourNodeList client:only="react" />
      </div>
      <TourChrome client:only="react" tourName={tour.name} />
      <button
        id="tour-fullscreen-btn"
        type="button"
        aria-label="Toggle fullscreen"
        class="pointer-events-auto fixed right-4 top-20 z-40 rounded-full border border-white/15 bg-black/55 px-4 py-2 text-xs font-semibold uppercase tracking-[0.15em] text-white backdrop-blur-xl transition hover:bg-black/70 md:top-6 md:right-6"
      >Fullscreen</button>
      <div class="pointer-events-none fixed bottom-4 right-4 z-40">
        <MapboxMiniMap client:only="react" />
      </div>
      <div class="pointer-events-none fixed bottom-28 right-6 z-30 max-md:bottom-24 max-md:left-1/2 max-md:right-auto max-md:-translate-x-1/2">
        <HotspotCompass client:only="react" />
      </div>
      <div class="pointer-events-none fixed right-0 top-0 z-40 h-full">
        <NodeInfoPanel client:only="react" />
      </div>
    </main>

    <script type="module">
      // keyboard + fullscreen logic giữ nguyên
      import { useTourStore } from '@stores/tourStore';
      const store = useTourStore;
      function normalizeYaw(y){return((y%360)+360)%360}
      function angularDistance(a,b){const d=Math.abs(normalizeYaw(a)-normalizeYaw(b));return Math.min(d,360-d)}
      function findNearest(hotspots,dir){if(!hotspots?.length)return null;return hotspots.map(h=>({h,d:angularDistance(h.yaw,dir)})).sort((a,b)=>a.d-b.d)[0]?.h??null}
      function closePanels(){store.setState({isMapVisible:false,isInfoVisible:false});window.dispatchEvent(new CustomEvent('tour:close-panels'))}
      function setMobileDefaults(){if(window.innerWidth<768)store.setState({isMapVisible:false})}
      function onKey(e){
        const active=document.activeElement;
        if(['INPUT','TEXTAREA','SELECT'].includes(active?.tagName??''))return;
        const state=store.getState();
        if(e.key.toLowerCase()==='m'){state.toggleMap();return}
        if(e.key.toLowerCase()==='i'){state.toggleInfo();return}
        if(e.key==='Escape'){closePanels();return}
        const dirs={ArrowUp:0,ArrowRight:90,ArrowDown:180,ArrowLeft:270};
        if(!(e.key in dirs))return;
        const h=findNearest(state.currentNode?.hotspots,dirs[e.key]);
        if(h){e.preventDefault();state.navigateTo(h.target_id)}
      }
      try{
        setMobileDefaults();
        window.addEventListener('keydown',onKey);
        window.addEventListener('resize',setMobileDefaults,{passive:true});
        document.getElementById('tour-fullscreen-btn')?.addEventListener('click',async()=>{
          if(!document.fullscreenElement)await document.documentElement.requestFullscreen?.();
          else await document.exitFullscreen?.();
        });
      }catch(e){console.error('Tour init error',e)}
    </script>
  </BaseLayout>
)}